{
  "name": "@audiomass/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "clean": "node ../../tooling/clean.mjs dist coverage src/generated",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.2.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@audiomass/config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "eslint": "9.39.2",
    "prisma": "7.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
