generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectVisibility {
  PRIVATE
  SHARED
}

enum ProcessingJobKind {
  ANALYZE
  NORMALIZE
  TRANSCRIBE
  STEM_SEPARATION
  MASTER
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StorageProvider {
  S3
  MINIO
  SUPABASE
  VERCEL_BLOB
}

enum StorageObjectStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

model Project {
  id             String            @id @default(uuid()) @db.Uuid
  ownerId        String            @db.VarChar(120)
  name           String            @db.VarChar(160)
  description    String?           @db.VarChar(2000)
  visibility     ProjectVisibility @default(PRIVATE)
  version        Int               @default(1)
  timeline       Json              @default("[]")
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  jobs           ProcessingJob[]
  storageObjects StorageObject[]

  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("projects")
}

model ProcessingJob {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String?             @db.Uuid
  kind           ProcessingJobKind
  status         ProcessingJobStatus @default(QUEUED)
  progress       Int                 @default(0)
  input          Json
  output         Json?
  idempotencyKey String?             @unique @db.VarChar(128)
  errorCode      String?             @db.VarChar(80)
  errorMessage   String?             @db.VarChar(2000)
  startedAt      DateTime?           @db.Timestamptz(3)
  completedAt    DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("processing_jobs")
}

model StorageObject {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String?             @db.Uuid
  ownerId        String              @db.VarChar(120)
  provider       StorageProvider
  bucket         String              @db.VarChar(255)
  objectKey      String              @db.VarChar(1024)
  originalName   String              @db.VarChar(255)
  contentType    String              @db.VarChar(160)
  expectedSize   Int
  actualSize     Int?
  checksumSha256 String?             @db.Char(64)
  etag           String?             @db.VarChar(255)
  externalUrl    String?             @db.VarChar(2048)
  status         StorageObjectStatus @default(PENDING)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([provider, bucket, objectKey])
  @@index([ownerId, status, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("storage_objects")
}
