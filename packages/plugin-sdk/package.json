{
  "name": "@audiomass/plugin-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node ../../tooling/clean.mjs dist coverage",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@audiomass/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
