# Shared application secrets (replace before any non-local deployment)
API_KEYS=local-api-key-change-me-000000000000000000000000
PYTHON_API_INTERNAL_KEY=local-python-key-change-me-00000000000000000000

# PostgreSQL
POSTGRES_DB=audiomass
POSTGRES_USER=audiomass
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://audiomass:change-me@postgres:5432/audiomass

# Public web and API
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Processing service
PYTHON_API_URL=http://python-api:8000
PYTHON_API_ALLOWED_STORAGE_HOSTS=minio
PYTHON_API_ALLOW_INSECURE_STORAGE=true
PYTHON_API_MAX_CONCURRENT_JOBS=2
PYTHON_API_MAX_UPLOAD_BYTES=536870912
PYTHON_API_REMOTE_TIMEOUT_SECONDS=900
PYTHON_API_WHISPER_MODEL=small
PYTHON_API_WHISPER_DEVICE=cpu
PYTHON_API_WHISPER_COMPUTE_TYPE=int8

# Storage. The checked-in Compose stack uses MinIO; production may use any supported adapter.
STORAGE_PROVIDER=minio
STORAGE_BUCKET=audiomass
STORAGE_MAX_UPLOAD_BYTES=536870912
STORAGE_URL_TTL_SECONDS=900
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_KEY=audiomass
S3_SECRET=change-me-storage-secret

# Supabase adapter
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob adapter
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_ACCESS=private
