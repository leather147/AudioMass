PYTHON_API_INTERNAL_KEY=replace-with-at-least-one-32-character-secret
PYTHON_API_MAX_UPLOAD_BYTES=536870912
PYTHON_API_MAX_CONCURRENT_JOBS=2
PYTHON_API_LOG_LEVEL=INFO
PYTHON_API_ALLOWED_STORAGE_HOSTS=s3.eu-central-1.amazonaws.com
PYTHON_API_ALLOW_INSECURE_STORAGE=false
PYTHON_API_REMOTE_TIMEOUT_SECONDS=900

PYTHON_API_WHISPER_MODEL=small
PYTHON_API_WHISPER_DEVICE=cpu
PYTHON_API_WHISPER_COMPUTE_TYPE=int8

# Required on Vercel because the DSP and transcription dependencies exceed the
# standard Python Function bundle in many builds.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
