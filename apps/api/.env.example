NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://audiomass:change-me@localhost:5432/audiomass?schema=public
API_KEYS=replace-with-at-least-one-32-character-secret
CORS_ORIGINS=http://localhost:3000
PYTHON_API_URL=http://localhost:8000
PYTHON_API_INTERNAL_KEY=replace-with-the-same-32-character-internal-secret
PYTHON_API_TIMEOUT_MS=900000


# Direct-to-cloud file storage: s3, minio, supabase, or vercel-blob
STORAGE_PROVIDER=s3
STORAGE_BUCKET=audiomass
STORAGE_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=536870912

S3_REGION=eu-central-1
S3_ENDPOINT=
S3_KEY=replace-with-access-key
S3_SECRET=replace-with-secret-key

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_ACCESS=private
