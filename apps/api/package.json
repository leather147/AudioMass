    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "9.3.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@supabase/supabase-js": "2.110.7",
    "@vercel/blob": "2.6.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
