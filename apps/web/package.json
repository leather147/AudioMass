{
  "name": "@audiomass/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audio-engine:build": "pnpm --filter @audiomass/audio-engine build",
    "prebuild": "pnpm audio-engine:build",
    "build": "next build",
    "clean": "node ../../tooling/clean.mjs .next coverage",
    "predev": "pnpm audio-engine:build",
    "dev": "next dev --turbopack",
    "lint": "eslint . --max-warnings=0",
    "start": "next start",
    "pretest": "pnpm audio-engine:build",
    "test": "vitest run",
    "pretypecheck": "pnpm audio-engine:build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@audiomass/audio-engine": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@audiomass/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
